{
  "cases": [
    {
      "case_id": "recommendation.local_files_happy_path",
      "suite": "smoke",
      "behavior": "Extracts method from a provided local file and applies scaling.",
      "runner": "recommendation",
      "request": {
        "request_text": "Extract the final LC-MS/MS method for carotenoids in plasma",
        "analyte_name": "carotenoids",
        "matrix_hint": "human plasma",
        "require_mass_spectrometry": true,
        "source_mode": "local_files",
        "local_paths": ["tests/paper_example/Development of an Advanced HPLC–MS_MS Method for the Determination of Carotenoids and Fat-Soluble Vitamins in Human Plasma.html"],
        "system_specs": {
          "column_manufacturer": "Waters",
          "column_name": "XBridge BEH C18",
          "column_chemistry": "C18",
          "column_length_mm": 100.0,
          "column_inner_diameter_mm": 2.1,
          "particle_size_um": 3.5,
          "available_solvents": ["Water", "Methanol"],
          "detector_types": ["MS/MS"]
        }
      },
      "expected_outcome": {
        "status": "completed",
        "recommended_paper_id": "Development-of-an-Advanced-HPLC-MS_MS-Method-for-the-Determination-of-Carotenoids-and-Fat-Soluble-Vitamins-in-Human-Plasma"
      },
      "expected_trace": {
        "runtime.status": "completed",
        "recommended_candidate.trust.trust_state": "local_file_extracted"
      }
    },
