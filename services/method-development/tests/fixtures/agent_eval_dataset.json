          "column_length_mm": 100.0,
          "column_inner_diameter_mm": 2.1,
          "particle_size_um": 1.7
        }
      },
      "expected_outcome": {
        "status": "completed",
        "recommended_paper_id": "seed-caffeine-rp18"
      },
      "expected_trace": {
        "runtime.status": "completed",
        "recommended_candidate.trust.trust_state": "seeded_corpus"
      }
    },
    {
      "case_id": "recommendation.local_corpus_metformin_hilic",
      "suite": "core",
      "behavior": "Uses seeded local corpus records to recommend a HILIC LC-MS/MS metformin plasma method without live search.",
      "runner": "recommendation",
      "request": {
        "request_text": "Recommend a HILIC LC-MS/MS method for metformin in human plasma",
        "analyte_name": "metformin",
        "target_smiles": "CN(C)C(=N)N=C(N)N",
        "matrix_hint": "human plasma",
        "preferred_mode": "hilic",
        "require_mass_spectrometry": true,
        "source_mode": "local_corpus",
        "max_run_time_min": 10,
        "system_specs": {
          "column_manufacturer": "Waters",
          "column_name": "Acquity BEH Amide",
          "column_chemistry": "amide",
          "column_length_mm": 150.0,
          "column_inner_diameter_mm": 2.1,
          "particle_size_um": 1.7,
          "available_solvents": ["Water", "Acetonitrile"],
          "detector_types": ["MS/MS"]
        }
      },
      "expected_outcome": {
        "status": "completed",
        "recommended_paper_id": "seed-metformin-hilic-beh-amide"
      },
      "expected_trace": {
        "runtime.status": "completed",
        "recommended_candidate.trust.trust_state": "seeded_corpus",
        "recommended_candidate.trust.validation_status": "valid",
        "recommended_candidate.review_summary.corpus_origin": "seeded"
      }
    },
    {
      "case_id": "orchestration.review_record_reuse",
      "suite": "smoke",
      "behavior": "Reuses existing review record when retry_existing is True.",
      "runner": "orchestration",
      "request": {
        "source_document": {
          "source_document_id": "eval-orch-001",
          "source_type": "html",
          "url": "https://example.test/eval-orch-001"
        },
        "html_content": "<html><head><title>HPLC Example</title></head><body><article><section><h2>Methods</h2><p>The selected method used a YMC-Pack ODS-AQ (150 x 4.6 mm, 3 um) column.</p><p>Eluent A: water. Eluent B: acetonitrile.</p><p>The flow rate was 1.0 mL/min.</p><p>The selected method run time was 12 min.</p><p>The selected gradient was 10 to 90% B over 10 min.</p></section><section><h2>Results</h2><p>Under the selected method, intermediate 2 had a retention time of 7.4 min.</p></section></article></body></html>",
        "retry_existing": true
      },
      "expected_outcome": {
        "registration_status": "reused",
        "extraction_status": "reused"
      },
      "expected_trace": {
        "steps.registration.status": "reused",
        "steps.extraction.status": "reused",
        "budget.total_steps_attempted": 3
      }
    },
