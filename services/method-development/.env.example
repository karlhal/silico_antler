
# ── Provider selection ────────────────────────────────────────────────────────
# Set to one of: zai | groq | gemini | openrouter | openai_compatible
# Use OpenRouter-only for local model-backed testing.
SILICO_METHOD_DEVELOPMENT_LLM_PROVIDER=openrouter

# ── Provider pool ─────────────────────────────────────────────────────────────
# Keep disabled for OpenRouter-only testing to avoid consuming other provider quotas.
# Enable to route across all configured providers by concurrency availability.
# Any provider whose API key is set will be added to the pool automatically.
# Combined free capacity: Z.AI 20 + Gemini ~12 + Groq ~5 + OpenRouter varies = ~37+ parallel slots.
SILICO_METHOD_DEVELOPMENT_PROVIDER_POOL_ENABLED=false

# ── API keys (add whichever you have) ────────────────────────────────────────
# Z.AI — GLM models, generous free tier (GLM-4-Plus: 20 concurrent, free)
# Get key at: https://open.bigmodel.cn/
SILICO_METHOD_DEVELOPMENT_ZAI_API_KEY=

# Google Gemini — fallback, large context window
# Get key at: https://aistudio.google.com/apikey
SILICO_METHOD_DEVELOPMENT_GOOGLE_API_KEY=

# Groq — low-latency Llama models, free tier
# Get key at: https://console.groq.com/keys
SILICO_METHOD_DEVELOPMENT_GROQ_API_KEY=

# OpenRouter — defaults to Gemma 3 27B for structured extraction stability
# Get key at: https://openrouter.ai/keys
SILICO_METHOD_DEVELOPMENT_OPENROUTER_API_KEY=

# ── Model overrides (optional — defaults are set per provider) ────────────────
# Leave blank to use per-provider defaults (recommended).
# Only set these when using LLM_PROVIDER= in single-provider mode.
#
# Z.AI defaults:        planner=glm-4.6                        worker=glm-4-plus
# Gemini defaults:      planner=gemini-2.5-pro                 worker=gemini-2.5-flash
# Groq defaults:        planner=llama-3.3-70b-versatile        worker=meta-llama/llama-4-scout-17b-16e-instruct
# OpenRouter defaults:  planner=google/gemma-4-31b-it:free  worker=google/gemma-4-31b-it:free
#   On rate limit or 404, client rotates through:
#     meta-llama/llama-3.3-70b-instruct:free → nvidia/nemotron-3-super-120b-a12b:free → mistralai/mistral-nemo:free → openrouter/free
#   All free, no credits consumed. openrouter/free auto-routes to whichever free model has capacity.
SILICO_METHOD_DEVELOPMENT_PLANNER_MODEL=
SILICO_METHOD_DEVELOPMENT_WORKER_MODEL=

# ── Custom OpenAI-compatible endpoint (advanced) ──────────────────────────────
# Set LLM_PROVIDER=openai_compatible and provide base URL + key to use any
# OpenAI-chat-compatible API (Ollama, vLLM, Azure OpenAI, etc.)
SILICO_METHOD_DEVELOPMENT_LLM_BASE_URL=

# ── Orchestration tuning ──────────────────────────────────────────────────────
SILICO_METHOD_DEVELOPMENT_ENABLE_LLM_ORCHESTRATION=true
SILICO_METHOD_DEVELOPMENT_LLM_TIMEOUT_SEC=20
SILICO_METHOD_DEVELOPMENT_LLM_MAX_CALLS_PER_RUN=6
SILICO_METHOD_DEVELOPMENT_QUERY_PLANNER_PARALLELISM=1
SILICO_METHOD_DEVELOPMENT_MAX_STEP_ATTEMPTS_PER_RUN=1
SILICO_METHOD_DEVELOPMENT_MAX_TOTAL_STEPS_PER_RUN=5

# Extraction concurrency — free OpenRouter models are capped at 20 requests/minute.
# Recommended: 2 for single-provider OpenRouter free models, 8 for pool with Z.AI.
SILICO_METHOD_DEVELOPMENT_EXTRACTION_CONCURRENCY=2

# Full-document PDF LLM recovery limit across the shortlisted candidates.
# Default matches the open-access shortlist cap so relevant later-ranked PDFs can be rescued.
SILICO_METHOD_DEVELOPMENT_FULL_DOCUMENT_LLM_FALLBACK_LIMIT=8
